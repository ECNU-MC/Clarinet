<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.ecnumc.clarinet.mapper.CustomerMapper">
    <select id="queryByUid" resultType="org.ecnumc.clarinet.po.Customer">
        SELECT id, uid, qq, created_at FROM customer WHERE uid = #{uid}
    </select>

    <select id="queryByQq" resultType="org.ecnumc.clarinet.po.Customer">
        SELECT id, uid, qq, created_at FROM customer WHERE qq = #{qq}
    </select>
</mapper>